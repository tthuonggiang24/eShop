@page "/product/{id:int}"
@using eShop.UseCases.ViewProductScreen.interfaces

@inject NavigationManager navigationManager
@inject IViewProductUseCase viewProduct
@inject IAddProductToCartUseCase addProductToCartUseCase

<div class="product-detail-page py-2">
    <div class="mb-4">
        <NavLink href="products" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2">
            <span class="oi oi-arrow-left" aria-hidden="true"></span>
            <span>Back to Products</span>
        </NavLink>
    </div>

    @if (product != null)
    {
        <div class="card border-0 shadow-sm p-3 p-md-4">
            <div class="row g-4 g-lg-5 align-items-center">
                <div class="col-md-6">
                    <div class="product-gallery-frame">
                        <img src="@product.ImageLink" alt="@product.Name" class="product-gallery-image" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="product-info-panel">
                        @if (!string.IsNullOrEmpty(product.Brand))
                        {
                            <span class="badge bg-light text-secondary border text-uppercase mb-2 px-3 py-2">
                                @product.Brand
                            </span>
                        }

                        <h1 class="product-heading mb-3">@product.Name</h1>

                        <div class="price-container mb-4">
                            <span class="product-price-large">@product.Price.ToString("c")</span>
                            <span class="badge bg-success-subtle text-success ms-2 px-2 py-1 small">In Stock</span>
                        </div>

                        <div class="product-description mb-4">
                            <h6 class="fw-bold text-muted text-uppercase small">Description</h6>
                            <p class="text-secondary leading-relaxed">
                                @(string.IsNullOrWhiteSpace(product.Description) ? "No detailed description provided for this item." : product.Description)
                            </p>
                        </div>

                        <div class="action-panel pt-3 border-top">
                            <button class="btn btn-primary btn-lg w-100 w-sm-auto px-5 py-3 d-flex align-items-center justify-content-center gap-2" @onclick="AddToCart">
                                <span class="oi oi-cart" aria-hidden="true"></span>
                                <span>Add to Cart</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <span class="oi oi-warning" aria-hidden="true"></span>
            </div>
            <h4 class="empty-state-title">Product Not Found</h4>
            <p class="empty-state-text">The product you are looking for does not exist or may have been removed.</p>
            <NavLink href="products" class="btn btn-primary">
                Return to Store
            </NavLink>
        </div>
    }
</div>

<style>
    .product-gallery-frame {
        background-color: #fafafa;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 380px;
        padding: 2rem;
        border: 1px solid var(--color-border);
    }
    .product-gallery-image {
        max-height: 340px;
        max-width: 100%;
        object-fit: contain;
    }
    .product-heading {
        font-size: 1.875rem;
        font-weight: 700;
        letter-spacing: -0.025em;
    }
    .product-price-large {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--color-primary);
        letter-spacing: -0.02em;
    }
    .product-description p {
        font-size: 1rem;
        line-height: 1.7;
    }
</style>

@code {
    private Product? product;

    [Parameter]
    public int Id { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Id > 0)
        {
            product = viewProduct.Execute(Id);
        }
    }

    private void AddToCart()
    {
        if (product != null)
        {
            addProductToCartUseCase.Execute(product.ProductId);
            navigationManager.NavigateTo("/cart");
        }
    }
}
