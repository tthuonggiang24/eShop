@inject NavigationManager navigationManager

<div class="card order-summary-card shadow-sm border">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3 pb-2 border-bottom">Order Summary</h5>

        <div class="d-flex justify-content-between py-2 small text-muted">
            <span>Items (@itemCount):</span>
            <span class="text-dark fw-medium">@itemsTotalPrice.ToString("c")</span>
        </div>

        <div class="d-flex justify-content-between py-2 small text-muted">
            <span>Shipping &amp; Handling:</span>
            <span class="badge bg-success-subtle text-success">Free</span>
        </div>

        <div class="d-flex justify-content-between py-2 small text-muted">
            <span>Estimated Tax:</span>
            <span class="text-dark fw-medium">$0.00</span>
        </div>

        <hr class="my-3" />

        <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="fw-bold fs-6">Order Total:</span>
            <span class="order-total-price">@itemsTotalPrice.ToString("c")</span>
        </div>

        @if (!HidePlaceOrder)
        {
            <button class="btn btn-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2" 
                    @onclick="PlaceOrder" 
                    disabled="@(itemCount == 0)">
                <span>Proceed to Checkout</span>
                <span class="oi oi-arrow-right" aria-hidden="true"></span>
            </button>
            <div class="text-center mt-3 text-muted small">
                <span class="oi oi-lock-locked me-1" aria-hidden="true"></span>
                <span>Encrypted &amp; Secure Checkout</span>
            </div>
        }
    </div>
</div>

<style>
    .order-summary-card {
        border-radius: var(--radius-md);
        background-color: #ffffff;
    }
    .order-total-price {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--color-primary);
        letter-spacing: -0.02em;
    }
</style>

@code {
    private int itemCount = 0;
    private double itemsTotalPrice = 0;

    [Parameter]
    public Order order { get; set; }

    [Parameter]
    public bool HidePlaceOrder { get; set; } = false;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (order != null && order.LineItems != null)
        {
            itemCount = order.LineItems.Count;
            itemsTotalPrice = 0;
            order.LineItems.ForEach(x => itemsTotalPrice += x.Product.Price * x.Quantity);
        }
    }

    private void PlaceOrder()
    {
        navigationManager.NavigateTo("/placeorder");
    }
}
