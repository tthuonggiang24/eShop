@inherits LayoutComponentBase

<PageTitle>eShop - Modern E-Commerce</PageTitle>

<div class="app-wrapper">
    <TopNavBar />
    
    <main class="main-content">
        <div class="container py-4">
            @Body
        </div>
    </main>

    <footer class="app-footer">
        <div class="container py-4 d-flex flex-column flex-sm-row justify-content-between align-items-center text-muted small">
            <div>
                &copy; @DateTime.Now.Year <strong>eShop</strong>. Designed with modern minimalism.
            </div>
            <div class="mt-2 mt-sm-0">
                <span class="text-secondary">Clean Architecture &amp; Blazor Server</span>
            </div>
        </div>
    </footer>
</div>
